{
  "name": "dsh-plugin-read-aloud",
  "version": "0.2.3",
  "description": "Read DSH replies aloud with Microsoft neural voices through a local edge-tts service: read the selection, from here to the end, or the whole reply, with voice and speed switching. Shift + right-click opens the panel; unreadable text is skipped.",
  "type": "module",
  "license": "MIT",
  "author": "wangrenjie1994",
  "homepage": "https://github.com/wangrenjie1994/dsh-plugin-read-aloud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangrenjie1994/dsh-plugin-read-aloud.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tts",
    "text-to-speech",
    "read-aloud",
    "speech",
    "edge-tts"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').rmSync('server/__pycache__',{recursive:true,force:true})\""
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "server",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
